# Azure OpenAI: use either API key authentication or an Azure Identity credential.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=YOUR_CHAT_DEPLOYMENT
OPENAI_API_VERSION=2025-03-01-preview

# Azure Container Apps Sandbox group shared by both console agents.
ACA_SANDBOX_REGION=YOUR_REGION
AZURE_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID
ACA_SANDBOX_RESOURCE_GROUP=YOUR_RESOURCE_GROUP
ACA_SANDBOX_GROUP=YOUR_SANDBOX_GROUP

# ACA Sandbox Disk IDs created from the two custom images.
CHART_SANDBOX_DISK_ID=YOUR_CHART_SANDBOX_DISK_ID
SUM_SITE_SANDBOX_DISK_ID=YOUR_SUM_SITE_SANDBOX_DISK_ID

# Optional local output location for generated chart PNG files.
CHART_OUTPUT_DIR=output/charts