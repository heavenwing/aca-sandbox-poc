AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=YOUR_CHAT_DEPLOYMENT
OPENAI_API_VERSION=2025-03-01-preview

ACA_SANDBOX_REGION=YOUR_REGION
AZURE_SUBSCRIPTION_ID=YOUR_SANDBOX_SUBSCRIPTION_ID
ACA_SANDBOX_RESOURCE_GROUP=YOUR_SANDBOX_RESOURCE_GROUP
ACA_SANDBOX_GROUP=YOUR_SANDBOX_GROUP
SUM_SITE_SANDBOX_DISK_ID=YOUR_SUM_SITE_SANDBOX_DISK_ID

ACA_JOB_SUBSCRIPTION_ID=YOUR_JOB_SUBSCRIPTION_ID
ACA_JOB_RESOURCE_GROUP=YOUR_JOB_RESOURCE_GROUP
ACA_JOB_ENVIRONMENT_ID=/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.App/managedEnvironments/YOUR_ENVIRONMENT
ACA_JOB_IDENTITY_ID=/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.ManagedIdentity/userAssignedIdentities/YOUR_IDENTITY
ACA_JOB_IDENTITY_CLIENT_ID=YOUR_USER_ASSIGNED_IDENTITY_CLIENT_ID
ACA_JOB_LOCATION=YOUR_REGION
ACA_JOB_IMAGE=YOUR_REGISTRY.azurecr.io/aca-sum-site-job:YOUR_IMMUTABLE_TAG
ACA_JOB_DEFAULT_TIMEZONE=Asia/Shanghai
ACA_JOB_NAME_PREFIX=sum-site
ACA_JOB_API_VERSION=2025-07-01
ACA_JOB_CPU=0.5
ACA_JOB_MEMORY=1Gi
ACA_JOB_REPLICA_TIMEOUT=1800
ACA_JOB_REPLICA_RETRY_LIMIT=0
ACA_JOB_OUTPUT_STORAGE_NAME=YOUR_ACA_ENV_STORAGE_NAME
ACA_JOB_OUTPUT_STORAGE_TYPE=AzureFile
SUM_SITE_OUTPUT_PATH=/mnt/output

ACA_JOB_REGISTRY_SERVER=YOUR_REGISTRY.azurecr.io
ACA_JOB_REGISTRY_USERNAME=YOUR_REGISTRY_USERNAME
ACA_JOB_REGISTRY_PASSWORD=YOUR_REGISTRY_PASSWORD

# SUM_SITE_URL is injected by the scheduled Job. Do not set it for ask_agent.py.